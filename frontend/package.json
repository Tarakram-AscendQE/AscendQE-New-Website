{
  "name": "ascendqe-lean-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "postcss": "^8.4.45",
    "prettier": "3.10.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.72.2",
    "vite": "^5.4.21"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 120,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
