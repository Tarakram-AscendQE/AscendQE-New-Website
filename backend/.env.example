# Copy to .env for local development. In production these are GoDaddy environment variables.

# Server (GoDaddy sets PORT itself)
PORT=5000
NODE_ENV=development

# AWS SES (email for the website forms)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SENDER_MAIL=hello@ascendqe.com
RECIPIENT_MAIL=hello@ascendqe.com

# Insights (articles) database: MySQL
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=ascendqe_blogs

# Insights studio sign-in tokens
JWT_SECRET=a-long-random-secret
JWT_EXPIRES_IN=7d

# Article image storage (S3-compatible). Leave empty to store images on local disk (wiped on every GoDaddy deploy).
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, STORAGE_REGION=auto
# AWS S3:        STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com,             STORAGE_REGION=<region>
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL images are served from (R2 public/custom domain, or S3/CloudFront URL), no trailing slash
STORAGE_PUBLIC_URL=
