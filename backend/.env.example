# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3001

# GoDaddy MySQL Database Configuration
DB_HOST=your-godaddy-mysql-host
DB_PORT=3306
DB_USER=your-godaddy-db-user
DB_PASSWORD=your-godaddy-db-password
DB_NAME=your-godaddy-db-name

# JWT Secret for Admin Auth
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=7d

# File Upload Directory (Relative to process.cwd() or absolute)
UPLOAD_DIR=public/uploads/blogs

# AWS SES Configuration for Email Services
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SENDER_MAIL=hello@ascendqe.com
RECIPIENT_MAIL=hello@ascendqe.com

