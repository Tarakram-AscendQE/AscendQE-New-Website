# Copy to .env for local development. In production these are GoDaddy environment variables.

# Server (GoDaddy sets PORT itself)
PORT=5000
NODE_ENV=development

# AWS SES (email for the website forms)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SENDER_MAIL=hello@ascendqe.com
RECIPIENT_MAIL=hello@ascendqe.com
